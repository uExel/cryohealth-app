{
  "$meta": {
    "name": "CryoHealth Mobile",
    "version": "0.1.0",
    "basis": "Modernist (Archivo, zero radius, 2px rules, flush-left) with the red accent reassigned to a glacial blue so red carries CRITICAL only.",
    "platforms": ["ios", "android"],
    "note": "Values are literal. Do not interpolate new colors. Every color below exists in both light and dark."
  },

  "color": {
    "light": {
      "bg": "#f2f6f9",
      "surface": "#e6eef4",
      "surface2": "#ffffff",
      "text": "#16232c",
      "muted": "#5b6f7c",
      "line": "rgba(22,35,44,0.32)",
      "lineSoft": "rgba(22,35,44,0.14)",
      "accent": "#0f6ea8",
      "accentInk": "#0a4d76",
      "accentSoft": "#d5e7f2",
      "onAccent": "#ffffff",
      "tier": {
        "normal": "#1f7a4d", "normalSoft": "#d9eee3",
        "watch": "#a37700", "watchSoft": "#f6e9c4",
        "high": "#d2600f", "highSoft": "#fbe3cf",
        "critical": "#c6231a", "criticalSoft": "#f8d9d6"
      },
      "onTier": "#ffffff"
    },
    "dark": {
      "bg": "#0d151a",
      "surface": "#16232c",
      "surface2": "#1d2d38",
      "text": "#e7f0f5",
      "muted": "#93a8b5",
      "line": "rgba(231,240,245,0.34)",
      "lineSoft": "rgba(231,240,245,0.14)",
      "accent": "#4aa8dd",
      "accentInk": "#9ed2f0",
      "accentSoft": "#12303f",
      "onAccent": "#ffffff",
      "tier": {
        "normal": "#4bbd84", "normalSoft": "#123024",
        "watch": "#e0b23c", "watchSoft": "#332811",
        "high": "#f2873a", "highSoft": "#3a2211",
        "critical": "#ff6a5e", "criticalSoft": "#3d1512"
      },
      "onTier": "#0d151a"
    }
  },

  "typography": {
    "family": {
      "display": "Archivo",
      "body": "Archivo",
      "urdu": "Noto Nastaliq Urdu"
    },
    "weights": { "regular": 400, "semibold": 600, "bold": 800 },
    "scale": {
      "hero":      { "size": 56, "lineHeight": 52, "weight": 800, "tracking": -1.9 },
      "display":   { "size": 40, "lineHeight": 40, "weight": 800, "tracking": -1.2 },
      "title1":    { "size": 30, "lineHeight": 32, "weight": 800, "tracking": -0.8 },
      "title2":    { "size": 24, "lineHeight": 28, "weight": 800, "tracking": -0.5 },
      "title3":    { "size": 19, "lineHeight": 22, "weight": 800, "tracking": -0.4 },
      "headline":  { "size": 17, "lineHeight": 21, "weight": 800, "tracking": -0.2 },
      "body":      { "size": 16, "lineHeight": 23, "weight": 400, "tracking": 0 },
      "bodyStrong":{ "size": 16, "lineHeight": 23, "weight": 600, "tracking": 0 },
      "callout":   { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0 },
      "footnote":  { "size": 13, "lineHeight": 18, "weight": 600, "tracking": 0 },
      "label":     { "size": 11, "lineHeight": 14, "weight": 800, "tracking": 1.2, "transform": "uppercase" },
      "badge":     { "size": 11, "lineHeight": 13, "weight": 800, "tracking": 1.3, "transform": "uppercase" }
    },
    "urduScale": {
      "note": "Nastaliq needs far more leading. Multiply lineHeight by 1.9–2.1 and add ~2px to size.",
      "title": { "size": 24, "lineHeight": 46 },
      "body":  { "size": 16, "lineHeight": 34 }
    },
    "minimums": { "bodyText": 15, "interactiveLabel": 13, "neverBelow": 11 }
  },

  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 10, "6": 12, "7": 14, "8": 16, "9": 20, "10": 22, "11": 26, "12": 28, "screenX": 16, "screenXWide": 20 },

  "radius": { "all": 0 },

  "border": { "hairline": 1, "rule": 2, "tierBar": 8, "tierBarList": 8, "tabIndicator": 3 },

  "size": {
    "minTouch": 44,
    "control": 52,
    "controlPrimary": 58,
    "listRow": 60,
    "tabBar": 62,
    "appBar": 56,
    "banner": 34
  },

  "elevation": {
    "note": "Nothing floats. Only two surfaces leave the plane: the SOS sheet and the CRITICAL interstitial, and both use a solid 3px top rule instead of a shadow.",
    "shadow": "none"
  },

  "motion": {
    "note": "Minimal. No decorative animation — many target devices are low-end.",
    "screenTransition": { "duration": 180, "easing": "ease-out" },
    "banner": { "duration": 140, "easing": "linear" },
    "criticalEntry": { "duration": 0, "note": "The CRITICAL interstitial appears instantly. Never animate a warning in." }
  }
}
